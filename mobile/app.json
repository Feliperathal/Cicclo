{
  "expo": {
    "name": "Cicclo",
    "slug": "cicclo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "android": {
      "package": "com.cicclo.mobile"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cicclo.mobile"
    }
  }
}
